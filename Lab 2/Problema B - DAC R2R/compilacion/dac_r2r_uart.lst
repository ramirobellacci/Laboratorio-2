                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 .equ BPS = 12
                                 
                                 .def aux       = r16
                                 .def aux2      = r17
                                 .def dato      = r18
                                 .def tecla     = r19
                                 .def muestra   = r20
                                 .def senal     = r21
                                 .def velocidad = r22
                                 
                                 .cseg
                                 .org 0x0000
000000 c000                          rjmp INICIO
                                 
                                 INICIO:
                                     ; inicializo stack pointer
000001 e008                          ldi aux, high(RAMEND)
000002 bf0e                          out SPH, aux
000003 ef0f                          ldi aux, low(RAMEND)
000004 bf0d                          out SPL, aux
                                 
000005 d00d                          rcall PUERTOS
000006 d014                          rcall USART
000007 d020                          rcall TIMER1
                                 
000008 e040                          ldi muestra, 0
000009 e050                          ldi senal, 0          ; 0 = senal 13, 1 = senal 15
00000a e064                          ldi velocidad, 4
00000b d075                          rcall CAMBIAR_VEL
                                 
00000c d059                          rcall MENU
                                 
                                 MAIN:
00000d d03e                          rcall LEER_USART
00000e d06a                          rcall ESPERAR_TIMER
00000f d095                          rcall BUSCAR_DATO
000010 d0a0                          rcall SACAR_DAC
000011 9543                          inc muestra
000012 cffa                          rjmp MAIN
                                 
                                 ;--------------------
                                 ; CONFIGURACION
                                 ;---------------------
                                 PUERTOS:
                                     ; D0 RX, D1 TX, D2-D7 salida DAC
000013 ef0c                          ldi aux, 0b11111100
000014 b90a                          out DDRD, aux
                                 
                                     ; D8-D9 salida DAC
000015 e003                          ldi aux, 0b00000011
000016 b904                          out DDRB, aux
                                 
000017 e000                          ldi aux, 0
000018 b90b                          out PORTD, aux
000019 b905                          out PORTB, aux
00001a 9508                          ret
                                 
                                 USART:
                                     ; 9600 baudios con clock de 16 MHz
00001b e000                          ldi aux, high(BPS)
00001c 9300 00c5                     sts UBRR0H, aux
00001e e00c                          ldi aux, low(BPS)
00001f 9300 00c4                     sts UBRR0L, aux
                                 
000021 e108                          ldi aux, (1<<RXEN0) | (1<<TXEN0)
000022 9300 00c1                     sts UCSR0B, aux
                                 
000024 e006                          ldi aux, (1<<UCSZ01) | (1<<UCSZ00)
000025 9300 00c2                     sts UCSR0C, aux
000027 9508                          ret
                                 
                                 TIMER1:
                                     ; Timer1 en CTC, sin interrupciones
000028 e000                          ldi aux, 0
000029 9300 0080                     sts TCCR1A, aux
                                 
00002b e009                          ldi aux, (1<<WGM12) | (1<<CS10)
00002c 9300 0081                     sts TCCR1B, aux
                                 
00002e e002                          ldi aux, (1<<OCF1A)
00002f 9300 0016                     sts TIFR1, aux
000031 9508                          ret
                                 
                                 ;-----------
                                 ; USART
                                 ;------------
                                 PUTC:
000032 9110 00c0                     lds aux2, UCSR0A
000034 ff15                          sbrs aux2, UDRE0
000035 cffc                          rjmp PUTC
000036 9300 00c6                     sts UDR0, aux
000038 9508                          ret
                                 
                                 GETC:
000039 9100 00c0                     lds aux, UCSR0A
00003b ff07                          sbrs aux, RXC0
00003c 9508                          ret
                                 
00003d 9130 00c6                     lds tecla, UDR0
                                 
00003f 3331                          cpi tecla, '1'
000040 f069                          breq ELEGIR_13
000041 3332                          cpi tecla, '2'
000042 f071                          breq ELEGIR_15
000043 323b                          cpi tecla, '+'
000044 f079                          breq MAS_RAPIDO
000045 323d                          cpi tecla, '-'
000046 f091                          breq MAS_LENTO
000047 363d                          cpi tecla, 'm'
000048 f0a9                          breq MOSTRAR_MENU
000049 343d                          cpi tecla, 'M'
00004a f099                          breq MOSTRAR_MENU
00004b 9508                          ret
                                 
                                 LEER_USART:
00004c dfec                          rcall GETC
00004d 9508                          ret
                                 
                                 ELEGIR_13:
00004e e050                          ldi senal, 0
00004f e040                          ldi muestra, 0
000050 9508                          ret
                                 
                                 ELEGIR_15:
000051 e051                          ldi senal, 1
000052 e040                          ldi muestra, 0
000053 9508                          ret
                                 
                                 MAS_RAPIDO:
000054 3064                          cpi velocidad, 4
000055 f011                          breq FIN_VEL1
000056 9563                          inc velocidad
000057 d029                          rcall CAMBIAR_VEL
                                 FIN_VEL1:
000058 9508                          ret
                                 
                                 MAS_LENTO:
000059 3060                          cpi velocidad, 0
00005a f011                          breq FIN_VEL2
00005b 956a                          dec velocidad
00005c d024                          rcall CAMBIAR_VEL
                                 FIN_VEL2:
00005d 9508                          ret
                                 
                                 MOSTRAR_MENU:
00005e d007                          rcall MENU
00005f 9508                          ret
                                 
                                 TEXTO:
000060 9105                          lpm aux, Z+
000061 3000                          cpi aux, 0
000062 f011                          breq FIN_TEXTO
000063 dfce                          rcall PUTC
000064 cffb                          rjmp TEXTO
                                 FIN_TEXTO:
000065 9508                          ret
                                 
                                 MENU:
000066 e8ea                          ldi ZL, low(2*TXT1)
000067 e0f1                          ldi ZH, high(2*TXT1)
000068 dff7                          rcall TEXTO
000069 eae0                          ldi ZL, low(2*TXT2)
00006a e0f1                          ldi ZH, high(2*TXT2)
00006b dff4                          rcall TEXTO
00006c eaee                          ldi ZL, low(2*TXT3)
00006d e0f1                          ldi ZH, high(2*TXT3)
00006e dff1                          rcall TEXTO
00006f ebec                          ldi ZL, low(2*TXT4)
000070 e0f1                          ldi ZH, high(2*TXT4)
000071 dfee                          rcall TEXTO
000072 ecec                          ldi ZL, low(2*TXT5)
000073 e0f1                          ldi ZH, high(2*TXT5)
000074 dfeb                          rcall TEXTO
000075 edea                          ldi ZL, low(2*TXT6)
000076 e0f1                          ldi ZH, high(2*TXT6)
000077 dfe8                          rcall TEXTO
000078 9508                          ret
                                 
                                 ;----------------
                                 ; TIMER Y DAC
                                 ;---------------------
                                 
                                 ESPERAR_TIMER:
000079 9100 0016                     lds aux, TIFR1
00007b ff01                          sbrs aux, OCF1A
00007c cffc                          rjmp ESPERAR_TIMER
                                 
00007d e002                          ldi aux, (1<<OCF1A)
00007e 9300 0016                     sts TIFR1, aux
000080 9508                          ret
                                 
                                 CAMBIAR_VEL:
000081 3060                          cpi velocidad, 0
000082 f039                          breq VEL0
000083 3061                          cpi velocidad, 1
000084 f041                          breq VEL1
000085 3062                          cpi velocidad, 2
000086 f049                          breq VEL2
000087 3063                          cpi velocidad, 3
000088 f051                          breq VEL3
000089 c00c                          rjmp VEL4
                                 
                                 VEL0:
00008a e01f                          ldi aux2, high(3999)
00008b e90f                          ldi aux, low(3999)
00008c c00b                          rjmp CARGAR_OCR
                                 
                                 VEL1:
00008d e017                          ldi aux2, high(1999)
00008e ec0f                          ldi aux, low(1999)
00008f c008                          rjmp CARGAR_OCR
                                 
                                 VEL2:
000090 e013                          ldi aux2, high(999)
000091 ee07                          ldi aux, low(999)
000092 c005                          rjmp CARGAR_OCR
                                 
                                 VEL3:
000093 e011                          ldi aux2, high(499)
000094 ef03                          ldi aux, low(499)
000095 c002                          rjmp CARGAR_OCR
                                 
                                 VEL4:
000096 e010                          ldi aux2, high(249)
000097 ef09                          ldi aux, low(249)
                                 
                                 CARGAR_OCR:
000098 9310 0089                     sts OCR1AH, aux2
00009a 9300 0088                     sts OCR1AL, aux
                                 
00009c e000                          ldi aux, 0
00009d 9300 0085                     sts TCNT1H, aux
00009f 9300 0084                     sts TCNT1L, aux
                                 
0000a1 e002                          ldi aux, (1<<OCF1A)
0000a2 9300 0016                     sts TIFR1, aux
0000a4 9508                          ret
                                 
                                 BUSCAR_DATO:
0000a5 3050                          cpi senal, 0
0000a6 f019                          breq TABLA_13
                                 
                                 TABLA_15:
0000a7 eee4                          ldi ZL, low(2*SENAL15)
0000a8 e0f2                          ldi ZH, high(2*SENAL15)
0000a9 c002                          rjmp SUMAR_INDICE
                                 
                                 TABLA_13:
0000aa eee4                          ldi ZL, low(2*SENAL13)
0000ab e0f1                          ldi ZH, high(2*SENAL13)
                                 
                                 SUMAR_INDICE:
0000ac 0fe4                          add ZL, muestra
0000ad e000                          ldi aux, 0
0000ae 1ff0                          adc ZH, aux
0000af 9124                          lpm dato, Z
0000b0 9508                          ret
                                 
                                 SACAR_DAC:
                                     ; bits 0 a 5 salen por D2 a D7
0000b1 2f02                          mov aux, dato
0000b2 730f                          andi aux, 0b00111111
0000b3 0f00                          lsl aux
0000b4 0f00                          lsl aux
                                 
0000b5 b11b                          in aux2, PORTD
0000b6 7013                          andi aux2, 0b00000011
0000b7 2b01                          or aux, aux2
0000b8 b90b                          out PORTD, aux
                                 
                                     ; bits 6 y 7 salen por D8 y D9
0000b9 2f02                          mov aux, dato
0000ba 9506                          lsr aux
0000bb 9506                          lsr aux
0000bc 9506                          lsr aux
0000bd 9506                          lsr aux
0000be 9506                          lsr aux
0000bf 9506                          lsr aux
                                 
0000c0 b115                          in aux2, PORTB
0000c1 7f1c                          andi aux2, 0b11111100
0000c2 2b01                          or aux, aux2
0000c3 b905                          out PORTB, aux
0000c4 9508                          ret
                                 
