000108 9110 0100                     lds temp2, modo
00010a 3010                          cpi temp2, 0
00010b f459                          brne actualizar_fin
                                 
00010c 9110 0103                     lds temp2, cuadro
00010e 9513                          inc temp2
00010f 3513                          cpi temp2, FRAME_COUNT
000110 f008                          brlo guardar_cuadro
000111 2711                          clr temp2
                                 
