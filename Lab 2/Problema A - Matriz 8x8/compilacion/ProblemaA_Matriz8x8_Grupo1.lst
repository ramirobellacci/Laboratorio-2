0000fa f7f1                          brne demora_2
0000fb 951a                          dec temp2
0000fc f7d9                          brne demora_1
0000fd 9508                          ret
                                 
                                 actualizar:
0000fe 9100 0102                     lds temp, contador
000100 9503                          inc temp
000101 9110 0101                     lds temp2, velocidad
