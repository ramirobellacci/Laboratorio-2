                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 .equ UBRR_VAL = 103
                                 .equ FRAME_COUNT = 83
                                 .equ SPEED_INIT = 18
                                 .equ SPEED_MIN = 4
                                 .equ SPEED_MAX = 45
                                 
                                 .def temp = r16
                                 .def temp2 = r17
                                 .def fila = r18
                                 .def patron = r19
                                 .def tecla = r20
                                 .def offl = r24
                                 .def offh = r25
                                 
                                 .dseg
000100                           modo:       .byte 1
000101                           velocidad:  .byte 1
000102                           contador:   .byte 1
000103                           cuadro:     .byte 1
                                 
                                 .cseg
                                 .org 0x0000
000000 c000                          rjmp reset
                                 
                                 ; INICIO
                                 reset:
000001 ef0f                          ldi temp, low(RAMEND)
000002 bf0d                          out SPL, temp
000003 e008                          ldi temp, high(RAMEND)
000004 bf0e                          out SPH, temp
                                 
000005 940e 001a                     call puertos_init
000007 940e 0023                     call uart_init
                                 
000009 e000                          ldi temp, 0
00000a 9300 0100                     sts modo, temp
00000c 9300 0102                     sts contador, temp
00000e 9300 0103                     sts cuadro, temp
                                 
000010 e102                          ldi temp, SPEED_INIT
000011 9300 0101                     sts velocidad, temp
                                 
000013 940e 0118                     call imprimir_menu
                                 
                                 principal:
000015 940e 0095                     call barrido
000017 940e 00fe                     call actualizar
000019 cffb                          rjmp principal
                                 
                                 ; CONFIGURACION
                                 puertos_init:
                                     ; d0 rx, d1 tx, d2 a d7 filas
00001a ef0e                          ldi temp, 0b11111110
00001b b90a                          out DDRD, temp
                                 
                                     ; d8 y d9 filas, d10 a d13 columnas
00001c e30f                          ldi temp, 0b00111111
00001d b904                          out DDRB, temp
                                 
                                     ; a0 a a3 columnas
00001e e00f                          ldi temp, 0b00001111
00001f b907                          out DDRC, temp
                                 
000020 940e 00ee                     call apagar_matriz
000022 9508                          ret
                                 
                                 uart_init:
000023 e000                          ldi temp, high(UBRR_VAL)
000024 9300 00c5                     sts UBRR0H, temp
000026 e607                          ldi temp, low(UBRR_VAL)
000027 9300 00c4                     sts UBRR0L, temp
                                 
000029 e108                          ldi temp, (1 << RXEN0) | (1 << TXEN0)
00002a 9300 00c1                     sts UCSR0B, temp
                                 
00002c e006                          ldi temp, (1 << UCSZ01) | (1 << UCSZ00)
00002d 9300 00c2                     sts UCSR0C, temp
00002f 9508                          ret
                                 
                                 ; UART
                                 uart_tx:
000030 9110 00c0                     lds temp2, UCSR0A
000032 ff15                          sbrs temp2, UDRE0
000033 cffc                          rjmp uart_tx
000034 9300 00c6                     sts UDR0, temp
000036 9508                          ret
                                 
                                 uart_texto:
000037 9105                          lpm temp, Z+
000038 3000                          cpi temp, 0
000039 f019                          breq uart_texto_fin
00003a 940e 0030                     call uart_tx
00003c cffa                          rjmp uart_texto
                                 uart_texto_fin:
00003d 9508                          ret
                                 
                                 leer_uart:
00003e 9100 00c0                     lds temp, UCSR0A
000040 ff07                          sbrs temp, RXC0
000041 9508                          ret
                                 
000042 9140 00c6                     lds tecla, UDR0
                                 
000044 3341                          cpi tecla, '1'
000045 f089                          breq comando_texto
000046 3342                          cpi tecla, '2'
000047 f0a9                          breq comando_figura1
000048 3343                          cpi tecla, '3'
000049 f0b9                          breq comando_figura2
00004a 3344                          cpi tecla, '4'
00004b f0c9                          breq comando_figura3
00004c 3345                          cpi tecla, '5'
00004d f0d9                          breq comando_prueba
00004e 324b                          cpi tecla, '+'
00004f f0e9                          breq comando_mas_rapido
000050 324d                          cpi tecla, '-'
000051 f169                          breq comando_mas_lento
000052 364d                          cpi tecla, 'm'
000053 f1f1                          breq comando_menu
000054 344d                          cpi tecla, 'M'
000055 f1e1                          breq comando_menu
000056 9508                          ret
                                 
                                 comando_texto:
000057 e000                          ldi temp, 0
000058 9300 0100                     sts modo, temp
00005a 9300 0103                     sts cuadro, temp
00005c 9508                          ret
                                 
                                 comando_figura1:
00005d e001                          ldi temp, 1
00005e 9300 0100                     sts modo, temp
000060 9508                          ret
                                 
                                 comando_figura2:
000061 e002                          ldi temp, 2
000062 9300 0100                     sts modo, temp
000064 9508                          ret
                                 
                                 comando_figura3:
000065 e003                          ldi temp, 3
000066 9300 0100                     sts modo, temp
000068 9508                          ret
                                 
                                 comando_prueba:
000069 e004                          ldi temp, 4
00006a 9300 0100                     sts modo, temp
00006c 9508                          ret
                                 
                                 comando_mas_rapido:
00006d 9100 0101                     lds temp, velocidad
00006f 3009                          cpi temp, 9
000070 f038                          brlo velocidad_minima
000071 5005                          subi temp, 5
000072 9300 0101                     sts velocidad, temp
000074 2711                          clr temp2
000075 9310 0102                     sts contador, temp2
000077 9508                          ret
                                 
                                 velocidad_minima:
000078 e004                          ldi temp, SPEED_MIN
000079 9300 0101                     sts velocidad, temp
00007b 2711                          clr temp2
00007c 9310 0102                     sts contador, temp2
00007e 9508                          ret
                                 
                                 comando_mas_lento:
00007f 9100 0101                     lds temp, velocidad
000081 3209                          cpi temp, 41
000082 f440                          brsh velocidad_maxima
000083 e015                          ldi temp2, 5
000084 0f01                          add temp, temp2
000085 9300 0101                     sts velocidad, temp
000087 2711                          clr temp2
000088 9310 0102                     sts contador, temp2
00008a 9508                          ret
                                 
                                 velocidad_maxima:
00008b e20d                          ldi temp, SPEED_MAX
00008c 9300 0101                     sts velocidad, temp
00008e 2711                          clr temp2
00008f 9310 0102                     sts contador, temp2
000091 9508                          ret
                                 
                                 comando_menu:
000092 940e 0118                     call imprimir_menu
000094 9508                          ret
                                 
                                 ; MATRIZ
                                 barrido:
000095 e020                          ldi fila, 0
                                 barrido_loop:
000096 940e 00a4                     call cargar_patron
000098 940e 00d1                     call mostrar_fila
00009a 940e 00f7                     call demora_fila
00009c 940e 003e                     call leer_uart
                                 
00009e 9523                          inc fila
00009f 3028                          cpi fila, 8
0000a0 f3a8                          brlo barrido_loop
                                 
0000a1 940e 00ee                     call apagar_matriz
0000a3 9508                          ret
                                 
                                 cargar_patron:
0000a4 9100 0100                     lds temp, modo
0000a6 3000                          cpi temp, 0
0000a7 f039                          breq cargar_texto
0000a8 3001                          cpi temp, 1
0000a9 f0b9                          breq cargar_figura1
0000aa 3002                          cpi temp, 2
0000ab f0c1                          breq cargar_figura2
0000ac 3003                          cpi temp, 3
0000ad f0c9                          breq cargar_figura3
0000ae c01b                          rjmp cargar_prueba
                                 
                                 cargar_texto:
0000af 9180 0103                     lds offl, cuadro
0000b1 2799                          clr offh
0000b2 0f88                          lsl offl
0000b3 1f99                          rol offh
0000b4 0f88                          lsl offl
0000b5 1f99                          rol offh
0000b6 0f88                          lsl offl
0000b7 1f99                          rol offh
                                 
0000b8 e2e2                          ldi ZL, low(2 * cuadros_texto)
0000b9 e0f3                          ldi ZH, high(2 * cuadros_texto)
0000ba 0fe8                          add ZL, offl
0000bb 1ff9                          adc ZH, offh
0000bc 0fe2                          add ZL, fila
0000bd 2700                          clr temp
0000be 1ff0                          adc ZH, temp
0000bf 9134                          lpm patron, Z
0000c0 9508                          ret
                                 
                                 cargar_figura1:
0000c1 e0e2                          ldi ZL, low(2 * figura_corazon)
0000c2 e0f3                          ldi ZH, high(2 * figura_corazon)
0000c3 c008                          rjmp cargar_figura
                                 
                                 cargar_figura2:
0000c4 e0ea                          ldi ZL, low(2 * figura_cara)
0000c5 e0f3                          ldi ZH, high(2 * figura_cara)
0000c6 c005                          rjmp cargar_figura
                                 
                                 cargar_figura3:
0000c7 e1e2                          ldi ZL, low(2 * figura_flecha)
0000c8 e0f3                          ldi ZH, high(2 * figura_flecha)
0000c9 c002                          rjmp cargar_figura
                                 
                                 cargar_prueba:
