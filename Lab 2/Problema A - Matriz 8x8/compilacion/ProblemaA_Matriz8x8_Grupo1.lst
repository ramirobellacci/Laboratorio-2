0000cb e0f3                          ldi ZH, high(2 * figura_prueba)
                                 
                                 cargar_figura:
0000cc 0fe2                          add ZL, fila
0000cd 2700                          clr temp
0000ce 1ff0                          adc ZH, temp
0000cf 9134                          lpm patron, Z
0000d0 9508                          ret
                                 
                                 mostrar_fila:
0000d1 940e 00ee                     call apagar_matriz
                                 
                                     ; columnas c1 a c4 en d13 a d10
0000d3 2f03                          mov temp, patron
0000d4 7f00                          andi temp, 0xF0
0000d5 9506                          lsr temp
0000d6 9506                          lsr temp
0000d7 6003                          ori temp, 0b00000011
                                 
0000d8 3026                          cpi fila, 6
0000d9 f411                          brne revisar_fila8
0000da 7f0e                          andi temp, 0b11111110
0000db c003                          rjmp sacar_puerto_b
                                 
                                 revisar_fila8:
0000dc 3027                          cpi fila, 7
0000dd f409                          brne sacar_puerto_b
0000de 7f0d                          andi temp, 0b11111101
                                 
                                 sacar_puerto_b:
0000df b905                          out PORTB, temp
                                 
                                     ; columnas c5 a c8 en a3 a a0
0000e0 2f03                          mov temp, patron
0000e1 700f                          andi temp, 0x0F
0000e2 b908                          out PORTC, temp
                                 
                                     ; filas f1 a f6 en d2 a d7
0000e3 efea                          ldi ZL, low(2 * tabla_filas_d)
0000e4 e0f2                          ldi ZH, high(2 * tabla_filas_d)
0000e5 0fe2                          add ZL, fila
0000e6 2700                          clr temp
0000e7 1ff0                          adc ZH, temp
0000e8 9114                          lpm temp2, Z
                                 
0000e9 b10b                          in temp, PORTD
0000ea 7003                          andi temp, 0b00000011
0000eb 2b01                          or temp, temp2
0000ec b90b                          out PORTD, temp
0000ed 9508                          ret
                                 
                                 apagar_matriz:
0000ee b10b                          in temp, PORTD
0000ef 7003                          andi temp, 0b00000011
0000f0 6f0c                          ori temp, 0b11111100
0000f1 b90b                          out PORTD, temp
                                 
0000f2 e003                          ldi temp, 0b00000011
0000f3 b905                          out PORTB, temp
                                 
0000f4 e000                          ldi temp, 0
0000f5 b908                          out PORTC, temp
0000f6 9508                          ret
                                 
                                 demora_fila:
0000f7 e416                          ldi temp2, 70
                                 demora_1:
